VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_PAYMENTS_ENABLED=false
# Server-side only. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side
PAYSTACK_SECRET_KEY=replace-me-server-side
PUBLIC_APP_URL=http://localhost:5173
PAYSTACK_WEBHOOK_SECRET=replace-me-server-side
TRANSACTIONAL_EMAIL_API_KEY=replace-me-server-side
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-me-server-side
RESEND_WEBHOOK_SECRET=replace-me-server-side
EMAIL_FROM=notifications@example.com
NOTIFICATION_WORKER_SECRET=replace-me-server-side
# Comma-separated browser origins accepted by Edge Functions, for example https://tchow.example
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
